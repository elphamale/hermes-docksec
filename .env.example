# ── DockSec Tool Configuration ────────────────────────────────────────────────

# LLM endpoint — any OpenAI-compatible URL.
# Leave unset to run in scan-only mode (no AI recommendations).
DOCKSEC_LLM_BASE_URL=

# API key for the endpoint above.
# For keyless local routers, use any non-empty string.
DOCKSEC_LLM_API_KEY=unused

# Model name/alias to request.
# "auto" works for routers that select by complexity (Manifest, some proxies).
# For direct providers, use the actual model ID: gpt-4o, claude-sonnet-4-6, etc.
DOCKSEC_LLM_MODEL=auto

# ── Examples by backend ───────────────────────────────────────────────────────
# Manifest router (hosted — this is what Hermes itself uses):
#   DOCKSEC_LLM_BASE_URL=https://app.manifest.build/v1
#   DOCKSEC_LLM_API_KEY=mnfst_...
#   DOCKSEC_LLM_MODEL=auto
#
# NOTE: a locally self-hosted `manifestdotbuild/manifest` web app (often on
# :2099) is NOT an LLM endpoint — it's a dashboard. Use the hosted router URL
# above, or any other OpenAI-compatible provider below.
#
# LiteLLM proxy:
#   DOCKSEC_LLM_BASE_URL=http://localhost:4000/v1
#   DOCKSEC_LLM_API_KEY=your-litellm-key
#   DOCKSEC_LLM_MODEL=claude-sonnet-4-6
#
# OpenRouter:
#   DOCKSEC_LLM_BASE_URL=https://openrouter.ai/api/v1
#   DOCKSEC_LLM_API_KEY=sk-or-...
#   DOCKSEC_LLM_MODEL=anthropic/claude-sonnet-4-6
#
# OpenAI direct:
#   DOCKSEC_LLM_BASE_URL=https://api.openai.com/v1
#   DOCKSEC_LLM_API_KEY=sk-...
#   DOCKSEC_LLM_MODEL=gpt-4o
#
# Ollama (local):
#   DOCKSEC_LLM_BASE_URL=http://localhost:11434/v1
#   DOCKSEC_LLM_API_KEY=ollama
#   DOCKSEC_LLM_MODEL=llama3.1

# ── Scanner config ────────────────────────────────────────────────────────────
DOCKSEC_RESULTS_DIR=~/.hermes/docksec/results
DOCKSEC_USE_CACHE=true
DOCKSEC_COMPACT_OUTPUT=true
TRIVY_SCAN_TIMEOUT=600

# ── Two-venv worker bridge ────────────────────────────────────────────────────
# docksec requires Python >= 3.12; Hermes runs on 3.11. The scanner therefore
# lives in a dedicated 3.12 venv and is invoked as a subprocess. Point these at
# that venv's python and the worker script. If unset, docksec_tool.py looks for
# a ./venv next to the worker, then falls back to python3.
DOCKSEC_WORKER_PYTHON=~/.hermes/docksec/venv/bin/python
DOCKSEC_WORKER_SCRIPT=~/.hermes/docksec/docksec_worker.py
DOCKSEC_WORKER_TIMEOUT=600

# Extra dirs prepended to the worker's PATH so it can find trivy/hadolint.
DOCKSEC_EXTRA_PATH=~/.local/bin
